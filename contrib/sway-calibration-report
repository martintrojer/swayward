#!/usr/bin/env python3
"""Diff a sway calibration run against swayward's coverage census.

Reads the TAP written by contrib/sway-calibration-run and joins it,
per assertion, with tests/i3/coverage.toml. It reports four rows, which are
the four questions this measurement exists to answer:

  SWAY_PASSES_DOCUMENTED_NONPASS
                 Sway passes an assertion coverage.toml itemises as a skip.
                 This is a CANDIDATE, not automatically a swayward bug: the
                 adapter may not preserve the X11/process/bar premise.
  BOTH_DIVERGE   both fail, so the assertion is compatible with an i3-only
                 classification. Read the citation before calling it confirmed.
  SWAY_FAILS_SWAYWARD_GREEN
                 Sway fails in a file whose non-skip assertions all pass for
                 swayward. Suspicious: sway may differ intentionally, or the
                 adapter may have made the premise easier.
  COMPATIBLE     both sides reach a compatible verdict.
  UNATTRIBUTABLE the file has unnumbered swayward failures, so a per-assertion
                 join is impossible from coverage.toml.

The joining key is the TAP assertion number, which is only valid while both
sides ran the same file at the same i3 commit. Files where the sway side
never produced TAP are reported separately as NO_SWAY_DATA; they carry no
information about swayward either way.

Usage:
    contrib/sway-calibration-report [--tapdir DIR] [--json] [--row ROW]
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLAN = re.compile(r"^1\.\.(\d+)(?:\s+#\s*SKIP\b.*)?$", re.IGNORECASE)
RESULT = re.compile(r"^(not ok|ok) (\d+)(.*)$")


def parse_tap(text: str) -> tuple[dict[int, str], int | None]:
    """Return {assertion number: pass|fail|skip} for the FIRST TAP stream.

    Same rule as contrib/tap-count: only the first unindented plan and the
    first stream are authoritative, because a repeated stream is an echo.
    """
    results: dict[int, str] = {}
    plan: int | None = None
    previous = 0
    for line in text.splitlines():
        if plan is None:
            m = PLAN.match(line)
            if m:
                plan = int(m.group(1))
                continue
        m = RESULT.match(line)
        if not m:
            continue
        status, number, trailer = m.group(1), int(m.group(2)), m.group(3)
        if number <= previous and results:
            break  # numbering restarted: second stream, stop
        previous = number
        if status == "ok" and re.search(r"#\s*skip", trailer, re.IGNORECASE):
            results[number] = "skip"
        else:
            results[number] = "pass" if status == "ok" else "fail"
    return results, plan


def swayward_verdicts(entry: dict) -> dict[int, str]:
    """Per-assertion swayward verdict from a coverage.toml file entry.

    coverage.toml itemises only skips; pass, fail and unreached are counts.
    So an assertion number is resolvable to "skip" exactly, and everything
    else is only resolvable in aggregate. Return the itemised skips; the
    caller treats the rest through the file's counts.
    """
    return {s["n"]: "skip" for s in entry.get("skip", [])}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--tapdir", default=str(REPO / "target" / "sway-calibration"))
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--tsv", action="store_true",
                    help="print attributable non-compatible assertion rows")
    ap.add_argument("--row", help="print only this row's members")
    args = ap.parse_args()

    tapdir = Path(args.tapdir)
    if not tapdir.is_dir():
        print(f"no TAP directory at {tapdir}; run contrib/sway-calibration-run first",
              file=sys.stderr)
        return 2

    cov = tomllib.loads((REPO / "tests" / "i3" / "coverage.toml").read_text())["files"]

    rows: dict[str, list] = {
        "SWAY_PASSES_DOCUMENTED_NONPASS": [], "BOTH_DIVERGE": [],
        "SWAY_FAILS_SWAYWARD_GREEN": [], "COMPATIBLE": [],
        "UNATTRIBUTABLE": [], "NO_SWAY_DATA": [],
    }
    file_summary = []

    for name in sorted(cov):
        entry = cov[name]
        tap = tapdir / f"{name}.tap"
        sway, sway_plan = parse_tap(tap.read_text(errors="replace")) if tap.exists() else ({}, None)

        declared = entry.get("assertions", 0)
        sw_skips = swayward_verdicts(entry)
        sw_pass_count = entry.get("pass", 0)
        sw_fail_count = entry.get("fail", 0) + entry.get("unreached", 0)

        if not sway:
            rows["NO_SWAY_DATA"].append(name)
            file_summary.append({
                "file": name, "sway_reached": 0, "sway_pass": 0,
                "swayward_assertions": declared, "note": "sway produced no TAP",
            })
            continue

        sway_pass = sum(1 for v in sway.values() if v == "pass")

        # Per-assertion join is only sound for the assertions coverage.toml
        # itemises, which is exactly its skip list. For those, swayward's
        # verdict is "does not pass"; sway's comes from the TAP.
        for n, _ in sorted(sw_skips.items()):
            verdict = sway.get(n)
            if verdict is None:
                continue  # sway never reached it
            row = next(s for s in entry["skip"] if s["n"] == n)
            item = {"file": name, "n": n,
                    "reason": row.get("reason", ""),
                    "citation": row.get("citation", "")}
            if verdict == "pass":
                rows["SWAY_PASSES_DOCUMENTED_NONPASS"].append(item)
            else:
                rows["BOTH_DIVERGE"].append(item)

        # SWAY_FAILS_SWAYWARD_GREEN is a file-level signal: coverage.toml does not number its
        # passes, so an assertion sway failed can only be attributed to
        # swayward's pass set by elimination.
        for n, verdict in sorted(sway.items()):
            if verdict == "fail" and n not in sw_skips and n <= declared:
                if sw_fail_count == 0:
                    # Every non-skip assertion in this file passes for
                    # swayward, so this one does.
                    rows["SWAY_FAILS_SWAYWARD_GREEN"].append({"file": name, "n": n})
                else:
                    rows["UNATTRIBUTABLE"].append({"file": name, "n": n,
                                                    "note": "file has swayward failures too"})
            elif verdict == "pass" and n not in sw_skips:
                if sw_fail_count:
                    rows["UNATTRIBUTABLE"].append({"file": name, "n": n,
                                                    "note": "file has swayward failures too"})
                else:
                    rows["COMPATIBLE"].append({"file": name, "n": n})

        file_summary.append({
            "file": name,
            "sway_reached": len(sway), "sway_pass": sway_pass,
            "sway_plan": sway_plan,
            "swayward_assertions": declared,
            "swayward_pass": sw_pass_count,
            "swayward_skip": len(sw_skips),
            "swayward_fail": sw_fail_count,
        })

    if args.row:
        for item in rows[args.row]:
            print(json.dumps(item) if isinstance(item, dict) else item)
        return 0

    if args.tsv:
        print("file\tassertion\tsway\tswayward\trow")
        table = []
        for row, sway, swayward in (
            ("SWAY_PASSES_DOCUMENTED_NONPASS", "pass", "documented_nonpass"),
            ("SWAY_FAILS_SWAYWARD_GREEN", "fail", "pass"),
            ("BOTH_DIVERGE", "fail", "documented_nonpass"),
        ):
            table.extend((item["file"], item["n"], sway, swayward, row)
                         for item in rows[row])
        for item in sorted(table):
            print("\t".join(map(str, item)))
        return 0

    if args.json:
        print(json.dumps({"rows": {k: len(v) for k, v in rows.items()},
                          "detail": rows, "files": file_summary}, indent=2))
        return 0

    total_sway_reached = sum(f["sway_reached"] for f in file_summary)
    total_sway_pass = sum(f["sway_pass"] for f in file_summary)
    print(f"files compared      : {len(file_summary)}")
    print(f"sway produced TAP   : {len(file_summary) - len(rows['NO_SWAY_DATA'])}")
    print(f"sway assertions run : {total_sway_reached} ({total_sway_pass} pass)")
    print()
    for row in ("SWAY_PASSES_DOCUMENTED_NONPASS", "SWAY_FAILS_SWAYWARD_GREEN",
                "BOTH_DIVERGE", "COMPATIBLE", "UNATTRIBUTABLE", "NO_SWAY_DATA"):
        print(f"{row:32s} {len(rows[row]):5d}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
