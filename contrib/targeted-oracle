#!/usr/bin/env python3
"""Print or run focused oracle rows selected from changed production paths."""

import argparse
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MAP = ROOT / "tests" / "oracle-targets.toml"
NON_PRODUCTION = (
    ".github/", "contrib/", "docs/", "resources/", "src/tests/", "tests/",
    "swayward-visual-tests/",
)


def changed_paths(base: str, paths: list[str]) -> list[str]:
    if paths:
        return paths
    output = subprocess.check_output(
        ["git", "-C", ROOT, "diff", "--name-only", f"{base}...HEAD"], text=True
    )
    return [line for line in output.splitlines() if line]


def commands(changed: list[str], oracle: Path, binary: Path, out_dir: Path) -> list[list[str]]:
    with MAP.open("rb") as file:
        targets = tomllib.load(file)["target"]
    selected = {"state": set(), "events": set(), "i3_derived": set(), "random_seeds": set()}
    mapped = set()
    for target in targets:
        matches = [path for path in changed if any(path.startswith(prefix) for prefix in target["paths"])]
        if not matches:
            continue
        mapped.update(matches)
        for key in selected:
            selected[key].update(target.get(key, []))
    production = [
        path for path in changed
        if path.endswith(".rs") and not path.startswith(NON_PRODUCTION)
    ]
    unknown = sorted(set(production) - mapped)
    if unknown:
        raise RuntimeError(
            "production paths lack targeted oracle coverage: " + ", ".join(unknown)
            + "; add tests/oracle-targets.toml entries or pass explicit sway-ipc-run rows"
        )
    runner = oracle / "contrib" / "sway-ipc-run"
    common = ["--compositor", "swayward", "--binary", str(binary)]
    result = []
    for corpus in ("state", "events"):
        names = sorted(selected[corpus])
        if names:
            result.append([
                str(runner), "scenarios", *common, "--corpus", corpus,
                *sum((["--scenario", name] for name in names), []),
                "--out", str(out_dir / f"{corpus}.toml"),
            ])
    names = sorted(selected["i3_derived"])
    if names:
        result.append([
            str(runner), "i3-derived", *common,
            *sum((["--scenario", name] for name in names), []),
            "--out", str(out_dir / "i3-derived.toml"),
        ])
    seeds = sorted(selected["random_seeds"])
    if seeds:
        result.append([
            str(runner), "random", *common, "--seeds", ",".join(map(str, seeds)),
            "--out", str(out_dir / "random.toml"),
        ])
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="*")
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--oracle", type=Path, default=ROOT / ".cache/sway-ipc-oracle")
    parser.add_argument("--binary", type=Path, default=ROOT / "target/release/swayward")
    parser.add_argument("--out-dir", type=Path, required=True)
    parser.add_argument("--run", action="store_true")
    args = parser.parse_args()
    try:
        selected = commands(
            changed_paths(args.base, args.paths), args.oracle, args.binary, args.out_dir
        )
    except (OSError, subprocess.CalledProcessError, RuntimeError) as error:
        print(f"targeted-oracle: {error}", file=sys.stderr)
        return 2
    if not selected:
        print("targeted-oracle: no oracle rows selected (non-production changes only)")
        return 0
    args.out_dir.mkdir(parents=True, exist_ok=True)
    for command in selected:
        print(shlex.join(command), flush=True)
        if args.run and subprocess.run(command, cwd=ROOT).returncode:
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
