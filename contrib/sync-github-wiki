#!/usr/bin/env python3
"""Audit and publish the tracked documentation to the GitHub wiki."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath
from urllib.parse import unquote

REPOSITORY = "martintrojer/swayward"
REMOTE = f"git@github.com:{REPOSITORY}.wiki.git"
# Publishing pushes over SSH; reading only needs anonymous HTTPS, which is what
# a CI runner has. raw.githubusercontent.com is NOT an option: it serves a
# stale cache for minutes after a push, so a freshness check built on it
# produces false failures. Read the wiki repository at its HEAD instead.
READ_REMOTE = f"https://github.com/{REPOSITORY}.wiki.git"
WIKI_URL = f"https://github.com/{REPOSITORY}/wiki/"
EXTRA_PAGES = (
    "SWAY_COMPATIBILITY.md",
    "SWAY_CONFIG_MIGRATION.md",
    "KNOWN_DEVIATIONS.md",
    "IPC_ORACLE_COVERAGE.md",
    # Linked from the pages above, so they must publish too or the audit
    # reports a dangling target.
    "RUN_COMMAND_AUDIT.md",
    "UPSTREAM.md",
    "DIVERGENCE.md",
)
LINK_RE = re.compile(r"!?\[[^]]*\]\(([^)]+)\)|<[^>]+(?:src|href)=[\"']([^\"']+)[\"']")

# Wiki page names contain colons ("Configuration:-Input.md"), which a naive URL parse
# misreads as a URL scheme. Treat a target as external only when it really is.
EXTERNAL_RE = re.compile(r"^(?:[a-z][a-z0-9+.-]*:)?//|^(?:https?|mailto|ftp):", re.IGNORECASE)


def is_external(target: str) -> bool:
    return bool(EXTERNAL_RE.match(target)) or target.startswith("#")



def published_sources(root: Path) -> set[Path]:
    wiki = root / "docs" / "wiki"
    sources = {path for path in wiki.rglob("*") if path.is_file()}
    sources.update(root / "docs" / name for name in EXTRA_PAGES)
    return sources


def publication(root: Path) -> dict[str, bytes]:
    wiki = root / "docs" / "wiki"
    files = {
        path.relative_to(wiki).as_posix(): path.read_bytes()
        for path in wiki.rglob("*")
        if path.is_file()
    }
    for name in EXTRA_PAGES:
        files[name] = (root / "docs" / name).read_bytes()
    pages = set(files)
    return {
        name: wiki_links(content, pages) if name.endswith(".md") else content
        for name, content in files.items()
    }


def audit_source_link_styles(root: Path) -> list[str]:
    """Reject repository-source wiki links outside the publication set."""
    errors = []
    published = published_sources(root)
    # `-z` emits raw NUL-separated paths. Without it git honours `core.quotepath`,
    # which defaults to true and renders a non-ASCII name as a quoted C string
    # (`"docs/wiki/Layer\342\200\220Shell-Components.md"`). Treating that as a
    # literal path raised FileNotFoundError in CI while passing on a checkout
    # with `core.quotepath=false` set locally.
    tracked = [
        name
        for name in run("git", "ls-files", "-z", "--", "*.md", cwd=root).stdout.split("\0")
        if name
    ]
    for name in tracked:
        source = root / name
        if source in published:
            continue
        text = source.read_text()
        for match in LINK_RE.finditer(text):
            target = (match.group(1) or match.group(2)).strip().strip("<>")
            link = target.split(maxsplit=1)[0]
            path, separator, fragment = link.partition("#")
            while path.startswith("./"):
                path = path[2:]
            if path.startswith("docs/wiki/") and path.endswith(".md"):
                page = path.removeprefix("docs/wiki/").removesuffix(".md")
                destination = WIKI_URL + page
                if separator:
                    destination += f"#{fragment}"
                line_number = text.count("\n", 0, match.start()) + 1
                errors.append(
                    f"{name}:{line_number}: link to {target} must use {destination}"
                )
    return errors


def wiki_links(content: bytes, pages: set[str]) -> bytes:
    """Rewrite `Page.md` links into the extensionless form the wiki serves.

    GitHub wiki pages have no `.md` extension: `/wiki/Getting-Started.md`
    302-redirects to raw.githubusercontent.com and serves unrendered markdown.
    The tracked copies keep the extension so they stay navigable in the repo
    file browser, so the rewrite happens at publication time. Assets keep their
    extension, and anything that is not a published page is left alone.
    """
    text = content.decode()

    def replace(match: re.Match[str]) -> str:
        target = (match.group(1) or match.group(2)).strip().strip("<>")
        path = target.split(maxsplit=1)[0]
        if is_external(path):
            return match.group(0)
        base, _, fragment = path.partition("#")
        # Tracked pages link each other as `./Page.md` as well as `Page.md`.
        key = unquote(base)
        while key.startswith("./"):
            key = key[2:]
        if not base.endswith(".md") or key not in pages:
            return match.group(0)
        rewritten = key[: -len(".md")] + (f"#{fragment}" if fragment else "")
        # GitHub's Markdown renderer interprets the colon in a relative target
        # such as `Configuration:-Input` as a URI scheme and drops the link.
        # Absolute wiki URLs remain links. Keep ordinary page names relative so
        # local clones and repository previews still behave normally.
        if ":" in key:
            rewritten = WIKI_URL + rewritten
        return match.group(0).replace(path, rewritten, 1)

    return LINK_RE.sub(replace, text).encode()


def audit_headings(files: dict[str, bytes]) -> list[str]:
    """Reject body h1s because GitHub already renders the page name as an h1."""
    errors = []
    excluded = {"README.md", "_Sidebar.md", "_Footer.md"}
    for name, content in files.items():
        if not name.endswith(".md") or PurePosixPath(name).name in excluded:
            continue
        fence = None
        for line_number, line in enumerate(content.decode().splitlines(), 1):
            marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
            if marker:
                run = marker.group(1)
                if fence is None:
                    fence = (run[0], len(run))
                elif run[0] == fence[0] and len(run) >= fence[1]:
                    fence = None
                continue
            if fence is None and line.startswith("# "):
                errors.append(
                    f"{name}:{line_number}: top-level heading duplicates the wiki page title"
                )
    return errors


def audit_links(files: dict[str, bytes]) -> list[str]:
    errors = []
    names = set(files)
    for name, content in files.items():
        if not name.endswith(".md"):
            continue
        text = content.decode()
        for match in LINK_RE.finditer(text):
            target = (match.group(1) or match.group(2)).strip().strip("<>")
            target = target.split(maxsplit=1)[0]
            if is_external(target):
                continue
            path = unquote(target.partition("#")[0])
            if not path:
                continue
            resolved = (PurePosixPath(name).parent / path).as_posix()
            while resolved.startswith("./"):
                resolved = resolved[2:]
            # Page links are published without the `.md` extension, so accept
            # either form: the wiki URL `Foo` or the tracked file `Foo.md`.
            if resolved not in names and f"{resolved}.md" not in names:
                line_number = text.count("\n", 0, match.start()) + 1
                errors.append(f"{name}:{line_number}: missing wiki target {target}")
    return errors


def run(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, check=check, text=True, capture_output=True)


def published_files(checkout: Path) -> dict[str, bytes]:
    """Read a wiki checkout into the shape `publication` returns."""
    return {
        path.relative_to(checkout).as_posix(): path.read_bytes()
        for path in checkout.rglob("*")
        if path.is_file() and ".git" not in path.relative_to(checkout).parts
    }


def freshness_errors(expected: dict[str, bytes], actual: dict[str, bytes]) -> list[str]:
    errors = [f"{name}: not published" for name in sorted(set(expected) - set(actual))]
    errors += [
        f"{name}: published but no longer in the repository"
        for name in sorted(set(actual) - set(expected))
    ]
    errors += [
        f"{name}: published content differs from the repository"
        for name in sorted(set(expected) & set(actual))
        if expected[name] != actual[name]
    ]
    return errors


def check_published(files: dict[str, bytes]) -> int:
    """Fail when the published wiki disagrees with what this tree would publish.

    Offline is a skip, not a failure: a contributor without network must not be
    blocked by a check whose entire input lives on github.com.
    """
    with tempfile.TemporaryDirectory(prefix="swayward-wiki-check-") as directory:
        checkout = Path(directory) / "wiki"
        clone = run(
            "git", "clone", "--quiet", "--depth", "1",
            READ_REMOTE, str(checkout), check=False,
        )
        if clone.returncode:
            detail = clone.stderr.strip().splitlines()
            print(
                f"skipping the wiki freshness check: cannot read {READ_REMOTE}\n"
                f"  {detail[-1] if detail else 'no error output'}",
                file=sys.stderr,
            )
            return 0
        errors = freshness_errors(files, published_files(checkout))

    if errors:
        print("published wiki is stale:", file=sys.stderr)
        print("\n".join(f"  {error}" for error in errors), file=sys.stderr)
        print("run ./contrib/sync-github-wiki to republish", file=sys.stderr)
        return 1
    print(f"published wiki matches the repository: {len(files)} files")
    return 0


def write_publication(destination: Path, files: dict[str, bytes]) -> None:
    for child in destination.iterdir():
        if child.name != ".git":
            shutil.rmtree(child) if child.is_dir() else child.unlink()
    for name, content in files.items():
        target = destination / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="audit links without publishing")
    parser.add_argument(
        "--check-published",
        action="store_true",
        help="verify the published wiki matches this tree, then exit (needs network)",
    )
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    files = publication(root)
    errors = audit_source_link_styles(root) + audit_headings(files) + audit_links(files)
    if errors:
        print("wiki audit failed:", file=sys.stderr)
        print("\n".join(f"  {error}" for error in errors), file=sys.stderr)
        return 1
    print(f"wiki link audit passed: {len(files)} files")
    if args.check_published:
        return check_published(files)
    if args.check:
        return 0

    probe = run("git", "ls-remote", REMOTE, check=False)
    if probe.returncode:
        print(
            "GitHub has not created the wiki repository yet.\n"
            f"Open https://github.com/{REPOSITORY}/wiki, click "
            '"Create the first page", and save it. Then rerun this command.',
            file=sys.stderr,
        )
        return 2

    with tempfile.TemporaryDirectory(prefix="swayward-wiki-") as directory:
        checkout = Path(directory) / "wiki"
        run("git", "clone", "--quiet", REMOTE, str(checkout))
        write_publication(checkout, files)
        run("git", "add", "--all", cwd=checkout)
        if run("git", "diff", "--cached", "--quiet", cwd=checkout, check=False).returncode == 0:
            print("wiki is already current")
            return 0
        run("git", "commit", "-m", "Publish documentation from the swayward repository", cwd=checkout)
        run("git", "push", "origin", "HEAD:master", cwd=checkout)
        print("wiki published")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
