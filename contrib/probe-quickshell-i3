#!/usr/bin/env bash
# Opt-in compatibility probe for Fedora Quickshell 0.2.1 revision dacfa9d.
set -euo pipefail

EXPECTED='quickshell 0.2.1, revision dacfa9de829ac7cb173825f593236bf2c21f637e, distributed by: Fedora Project'
[ "${RUN_REAL_CLIENT_TESTS:-}" = 1 ] || {
    echo 'set RUN_REAL_CLIENT_TESTS=1 to run the Quickshell compatibility probe' >&2
    exit 2
}
[ -n "${SWAYSOCK:-}" ] && [ -S "$SWAYSOCK" ] || {
    echo 'SWAYSOCK must name the private socket supplied by contrib/dev-run.sh' >&2
    exit 2
}
[ "$(qs --version)" = "$EXPECTED" ] || {
    echo "expected: $EXPECTED" >&2
    echo "actual:   $(qs --version 2>&1)" >&2
    exit 2
}

log=$(mktemp)
config="$(dirname "$0")/quickshell-i3-probe.qml"
mutated=""
if [ "${MUTATE_IPC_FIELD:-}" = 1 ]; then
    mutated=$(mktemp --suffix=.qml)
    sed 's/workspace.id === undefined/workspace.not_a_sway_field === undefined/' "$config" >"$mutated"
    config=$mutated
fi
trap 'rm -f "$log" ${mutated:+"$mutated"}' EXIT
set +e
timeout 20 qs --no-color --path "$config" >"$log" 2>&1
status=$?
set -e
cat "$log"
[ "$status" = 0 ] || { echo "PROBE FAIL: Quickshell exited $status" >&2; exit 1; }
! grep -Eiq 'WARN (qml|scene)|QQml|QML.*(warning|error)' "$log" || {
    echo 'PROBE FAIL: Quickshell emitted a QML warning or error' >&2
    exit 1
}
grep -q 'PROBE PASS focused-workspace=2' "$log" || {
    echo 'PROBE FAIL: success marker absent' >&2
    exit 1
}
"$(dirname "$0")/../target/debug/swaywardmsg" -r -t get_workspaces |
    python3 -c 'import json, sys; assert any(w["num"] == 2 and w["focused"] for w in json.load(sys.stdin))'
echo 'PROBE PASS ipc-focused-workspace=2'
