#!/bin/bash
# Run i3's own unmodified test files against real sway, for calibration.
#
#   contrib/sway-calibration-run 001-tile.t 122-split.t
#   contrib/sway-calibration-run --all
#   contrib/sway-calibration-run --list
#
# This is a MEASUREMENT, not a gate. It exists to check swayward's skip
# classifications against what sway actually does, per tests/i3/README.md and
# tests/i3/coverage.toml. Nothing here is expected to be green.
#
# It deliberately does NOT reuse swayward's adapter. tests/i3/lib/i3test.pm
# talks to swayward's private control socket, translates config through
# contrib/sway-to-kdl and creates Wayland clients inside the swayward fixture.
# Sway speaks none of that, so pointing SWAYSOCK at sway and reusing the
# adapter would measure the adapter. This runner uses UPSTREAM i3test.pm from
# i3's own checkout, and replaces exactly two files:
#   SocketActivation.pm  -- launches sway instead of i3
#   swaycal::Shim        -- replaces sync_with_i3, which sway has no protocol for
#
# tests/i3/t/*.t are never read by this script. It reads i3's own testcases/t,
# so there is no path by which a local edit could flatter the result.
#
# SAFETY (AGENTS.md: an uncapped test client once OOM-killed the host):
#   * every sway runs under systemd-run --scope with MemoryMax and
#     MemorySwapMax=0, plus a wall-clock timeout;
#   * SWAYSOCK and I3SOCK are unset before anything starts, and each sway gets
#     an explicit private socket path under a per-run temp dir, so nothing can
#     adopt the operator's ambient socket;
#   * everything is launched and reaped inside one shell invocation;
#   * /tmp/.X11-unix is bind-mounted per run inside a user namespace, so each
#     Xwayland gets a private :0 and cannot collide with the host's X sockets.
set -uo pipefail

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
REPO=$PWD

I3SRC=${I3SRC:-/var/home/martintrojer/hacking/i3}
SWAYBUILD=${SWAYBUILD:-/var/home/martintrojer/hacking/sway-1.12-build/build}
CONTAINER=${CONTAINER:-swayward-dev}
TIMEOUT=${TIMEOUT:-60}
MEMMAX=${MEMMAX:-2G}
OUT=${OUT:-$REPO/target/sway-calibration}

MODE=files
FILES=()
while [ $# -gt 0 ]; do
	case "$1" in
	--all) MODE=all; shift ;;
	--list) MODE=list; shift ;;
	--timeout) TIMEOUT=$2; shift 2 ;;
	--out) OUT=$2; shift 2 ;;
	-h|--help) sed -n '2,10p' "$0"; exit 0 ;;
	*) FILES+=("$1"); shift ;;
	esac
done

[ -x "$SWAYBUILD/sway/sway" ] || { echo "no sway at $SWAYBUILD/sway/sway" >&2; exit 1; }
[ -f "$I3SRC/testcases/lib/i3test.pm.in" ] || { echo "no i3 source at $I3SRC" >&2; exit 1; }

I3_PIN=9be3249ac5b377ed3270e36bca83df53d8023337
SWAY_PIN=88869399
[ "$(git -C "$I3SRC" rev-parse HEAD)" = "$I3_PIN" ] || {
	echo "i3 source is not at $I3_PIN" >&2; exit 1;
}
"$SWAYBUILD/sway/sway" --version | grep -q "$SWAY_PIN" || {
	echo "sway binary is not built from $SWAY_PIN" >&2; exit 1;
}

# The vendored set is the population we care about: a file i3 has but swayward
# does not vendor has no swayward row to compare against.
mapfile -t VENDORED < <(cd "$REPO/tests/i3/t" && ls *.t)

if [ "$MODE" = list ]; then printf '%s\n' "${VENDORED[@]}"; exit 0; fi
if [ "$MODE" = all ]; then FILES=("${VENDORED[@]}"); fi
[ ${#FILES[@]} -gt 0 ] || { echo "no test files given (use --all or --list)" >&2; exit 2; }

for t in "${FILES[@]}"; do
	cmp -s "$REPO/tests/i3/t/$t" "$I3SRC/testcases/t/$t" || {
		echo "$t differs from pinned i3; refusing a misaligned comparison" >&2
		exit 1
	}
done

mkdir -p "$OUT"

export I3SRC SWAYBUILD REPO OUT TIMEOUT MEMMAX
export SWAY_CAL_CONTENT_SHIM="${SWAY_CAL_CONTENT_SHIM:-}"
printf '%s\n' "${FILES[@]}" > "$OUT/.files"

distrobox enter "$CONTAINER" -- "$REPO/tests/i3/sway-calibration/run-inside.sh" 2>&1 | tee "$OUT/run.log"

echo
echo "TAP output: $OUT/*.tap"
