#!/usr/bin/env python3
"""Run rustfmt on Rust files hidden from cargo fmt behind include!()."""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INCLUDE = re.compile(r'^\s*include!\("([^"]+\.rs)"\);\s*$', re.MULTILINE)


def included_files() -> list[Path]:
    pending = list(ROOT.rglob("*.rs"))
    found = set()
    while pending:
        source = pending.pop()
        for name in INCLUDE.findall(source.read_text()):
            path = (source.parent / name).resolve()
            if path not in found:
                found.add(path)
                pending.append(path)
    return sorted(found)


def main() -> int:
    if sys.argv[1:] not in ([], ["--write"]):
        print("usage: contrib/check-rustfmt-fragments [--write]", file=sys.stderr)
        return 2
    files = included_files()
    command = ["rustfmt", "+nightly", "--edition", "2021"]
    if not sys.argv[1:]:
        command.append("--check")
    return subprocess.run([*command, *files], cwd=ROOT, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
