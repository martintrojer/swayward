#!/usr/bin/env bash
# Prove that the release metadata checker accepts this tree and rejects drift.

set -euo pipefail
cd "$(dirname "$0")/.."

version=$(python3 -c 'import tomllib; print(tomllib.load(open("Cargo.toml", "rb"))["workspace"]["package"]["version"])')
./contrib/check-release-consistency "swayward-v$version"

! grep -q '^\[package.metadata\.\(generate-rpm\|deb\)\]' Cargo.toml
grep -q '^Recommends:     foot$' swayward.spec.rpkg
grep -q '^Suggests: .*foot' contrib/build-deb

test "$(./contrib/package-version debian 26.4.0-beta.1)" = '26.4.0~beta.1'
test "$(./contrib/package-version rpm 26.4.0-beta.1)" = '26.4.0~beta.1'
test "$(./contrib/package-version arch 26.4.0-beta.1)" = '26.4.0beta1'
if command -v dpkg >/dev/null; then
    dpkg --compare-versions "$(./contrib/package-version debian 26.4.0-beta.1)" lt 26.4.0
fi

root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT
mkdir -p "$root/contrib"
cp Cargo.toml Cargo.lock swayward.spec.rpkg "$root/"
cp contrib/PKGBUILD contrib/.SRCINFO contrib/package-version "$root/contrib/"
for manifest in */Cargo.toml; do
    mkdir -p "$root/$(dirname "$manifest")"
    cp "$manifest" "$root/$manifest"
done

python3 - "$root/contrib/.SRCINFO" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
path.write_text(path.read_text().replace("\tcheckdepends = xkeyboard-config\n", ""))
PY
if ./contrib/check-release-consistency --root "$root" >/dev/null 2>"$root/srcinfo-error"; then
    echo "test-release-consistency: checker accepted missing .SRCINFO checkdepends" >&2
    exit 1
fi
grep -q 'contrib/.SRCINFO: checkdepends does not match contrib/PKGBUILD' "$root/srcinfo-error"
echo "deliberate .SRCINFO checkdepends mismatch rejected"

python3 - "$root/contrib/PKGBUILD" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text()
text, count = re.subn(r"^pkgver=\S+$", "pkgver=99.0.0", text, count=1, flags=re.MULTILINE)
assert count == 1
path.write_text(text)
PY

if ./contrib/check-release-consistency --root "$root" >/dev/null 2>"$root/error"; then
    echo "test-release-consistency: checker accepted a mismatched PKGBUILD" >&2
    exit 1
fi
grep -q "contrib/PKGBUILD: pkgver is '99.0.0'; expected '$version'" "$root/error"
echo "deliberate PKGBUILD mismatch rejected"
