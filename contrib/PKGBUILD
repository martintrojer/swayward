# Maintainer: Martin Trojer <martin.trojer@gmail.com>
#
# Reference PKGBUILD for the AUR package. Build and lint it with an Arch
# container before publishing:
#
#   distrobox create --name arch-pkg --image docker.io/library/archlinux:latest
#   distrobox enter arch-pkg -- bash -lc 'sudo pacman -S --needed base-devel namcap'
#   cd contrib && makepkg -s && namcap PKGBUILD *.pkg.tar.zst
#
# Publishing needs an AUR account with an SSH key; see
# https://wiki.archlinux.org/title/AUR_submission_guidelines

pkgname=swayward
pkgver=26.4.0
pkgrel=1
pkgdesc="An i3/sway-compatible Wayland compositor, built in Rust on Smithay"
arch=('x86_64' 'aarch64')
url="https://github.com/martintrojer/swayward"
license=('GPL-3.0-or-later')

# Arch enables LTO by default. libspa-sys generates a C shim for SPA's static
# inline functions (wrap_static_fns), and LTO discards those objects before
# the Rust side links against them, so the build fails with
# "undefined symbol: spa_format_parse_libspa_rs" and friends. Reproduced on a
# clean archlinux:latest container; unrelated to the libpipewire version.
options=('!lto')

depends=(
  'bash'          # swayward-session is a shell script
  'cairo'
  'libdisplay-info'
  'libinput'
  'libxkbcommon'
  'mesa'          # libgbm.so.1, libEGL
  'pango'
  'libpipewire'   # libspa-0.2.pc and libpipewire-0.3.so; the `pipewire`
                  # package is the daemon and does not carry them
  'seatd'         # libseat.so.1
  'systemd-libs'
  # namcap reports wayland as possibly unneeded because nothing links it at
  # build time: src/main.rs dlopens libwayland-server.so.0 with RTLD_NOLOAD
  # to set the max buffer size. It is required at runtime.
  'wayland'
)

makedepends=(
  'cargo'
  'clang'
  'git'
)

optdepends=(
  'xwayland-satellite: Xwayland support'
  'xdg-desktop-portal-gtk: portal backend for everything but screencast'
  'xdg-desktop-portal-wlr: ScreenCast and Screenshot portals, named by swayward-portals.conf'
  'gnome-keyring: Secret portal'
  'waybar: status bar, works unmodified against swayward IPC'
  'fuzzel: application launcher bound in the default config'
  'foot: terminal bound in the default config'
  'swaylock: screen locker'
  'swayidle: idle management'
  'swaybg: wallpaper'
  'mako: notifications'
  'sway: provides swaymsg; swayward ships swaywardmsg, so this is optional'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Exclude swayward-visual-tests: it is a GTK4 developer tool, not part of
  # the compositor, and building it would drag gtk4 and gdk-pixbuf into the
  # package's build dependencies for no runtime benefit.
  cargo build --frozen --release \
    --workspace --exclude swayward-visual-tests
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The i3 conformance suite needs Perl modules that are not build
  # dependencies, so run the Rust tests only.
  cargo test --frozen --release --lib -p swayward -p swayward-ipc -p swayward-config
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/swayward "$pkgdir/usr/bin/swayward"
  install -Dm755 target/release/swaywardmsg "$pkgdir/usr/bin/swaywardmsg"
  install -Dm755 resources/swayward-session "$pkgdir/usr/bin/swayward-session"

  install -Dm644 resources/swayward.desktop \
    "$pkgdir/usr/share/wayland-sessions/swayward.desktop"
  install -Dm644 resources/swayward-portals.conf \
    "$pkgdir/usr/share/xdg-desktop-portal/swayward-portals.conf"
  install -Dm644 resources/swayward.service \
    "$pkgdir/usr/lib/systemd/user/swayward.service"
  install -Dm644 resources/swayward-shutdown.target \
    "$pkgdir/usr/lib/systemd/user/swayward-shutdown.target"

  install -Dm644 resources/default-config.kdl \
    "$pkgdir/usr/share/swayward/default-config.kdl"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
