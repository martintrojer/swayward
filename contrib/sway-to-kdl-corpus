#!/usr/bin/env python3
"""Fetch and audit the opt-in public sway configuration corpus."""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = Path(__file__).with_suffix(".json")
CACHE = ROOT / ".cache" / "sway-to-kdl-corpus"


def run(command, **kwargs):
    return subprocess.run(command, text=True, capture_output=True, **kwargs)


def normalized_hash(path):
    lines = []
    for line in path.read_text(errors="replace").splitlines():
        line = re.sub(r"#.*", "", line).strip()
        if line:
            lines.append(re.sub(r"\s+", " ", line))
    return hashlib.sha256(("\n".join(lines) + "\n").encode()).hexdigest()


def acquire(entry, fetch):
    checkout = CACHE / entry["name"]
    if not checkout.exists():
        if not fetch:
            raise RuntimeError("not cached; rerun with --fetch")
        checkout.parent.mkdir(parents=True, exist_ok=True)
        result = run(["git", "clone", "--quiet", "--no-checkout", entry["repository"], checkout])
        if result.returncode:
            raise RuntimeError(result.stderr.strip())
    if fetch:
        result = run(["git", "-C", checkout, "fetch", "--quiet", "origin", entry["revision"]])
        if result.returncode:
            raise RuntimeError(result.stderr.strip())
        result = run(["git", "-C", checkout, "checkout", "--quiet", "--detach", entry["revision"]])
        if result.returncode:
            raise RuntimeError(result.stderr.strip())
    if run(["git", "-C", checkout, "rev-parse", "HEAD"]).stdout.strip() != entry["revision"]:
        raise RuntimeError("cached checkout is at the wrong revision; rerun with --fetch")
    source = checkout / entry["path"]
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    if digest != entry["sha256"]:
        raise RuntimeError(f"content hash mismatch: {digest}")
    if normalized_hash(source) != entry["normalized_sha256"]:
        raise RuntimeError("normalized content hash mismatch")
    return source


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fetch", action="store_true", help="acquire or refresh pinned repositories")
    parser.add_argument("--swayward", default="swayward", help="swayward executable used for validation")
    args = parser.parse_args()
    manifest = json.loads(MANIFEST.read_text())
    failures = 0
    print("name\texit\tmanual\tparse\tvalidate\tclassification")
    with tempfile.TemporaryDirectory() as temporary:
        sterile = Path(temporary)
        environment = {
            **os.environ,
            "HOME": str(sterile / "home"),
            "XDG_CONFIG_HOME": str(sterile / "config"),
            "XDG_CACHE_HOME": str(sterile / "cache"),
            "XDG_DATA_HOME": str(sterile / "data"),
            "XDG_STATE_HOME": str(sterile / "state"),
        }
        for directory in environment["HOME"], environment["XDG_CONFIG_HOME"], environment["XDG_CACHE_HOME"], environment["XDG_DATA_HOME"], environment["XDG_STATE_HOME"]:
            Path(directory).mkdir(parents=True, exist_ok=True)
        for entry in manifest["entries"]:
            try:
                source = acquire(entry, args.fetch)
                translated = run([ROOT / "contrib/sway-to-kdl", source], env=environment)
                manual_match = re.search(r"manual attention: (\d+|none)", translated.stderr)
                manual = manual_match.group(1) if manual_match else "?"
                output = sterile / f'{entry["name"]}.kdl'
                output.write_text(translated.stdout)
                validated = run([args.swayward, "validate", "-c", output], env=environment)
                valid = validated.returncode == 0
                parse = "ok" if valid else "fail"
                unresolved = any(
                    marker in translated.stderr
                    for marker in ("include matched no files", "include command substitution is refused")
                )
                if translated.returncode:
                    classification = "crash"
                elif not valid:
                    classification = "validation failure"
                elif unresolved:
                    classification = "unresolved environment or include"
                else:
                    classification = "expected manual attention"
                print(f'{entry["name"]}\t{translated.returncode}\t{manual}\t{parse}\t{"ok" if valid else "fail"}\t{classification}')
            except (OSError, RuntimeError) as error:
                failures += 1
                print(f'{entry["name"]}\t-\t-\t-\t-\tacquisition failure: {error}')
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
