pkgbase = swayward
	pkgdesc = An i3/sway-compatible Wayland compositor, built in Rust on Smithay
	pkgver = 26.4.0
	pkgrel = 1
	url = https://github.com/martintrojer/swayward
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = clang
	makedepends = git
	depends = bash
	depends = cairo
	depends = libdisplay-info
	depends = libinput
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = libpipewire
	depends = seatd
	depends = systemd-libs
	depends = wayland
	optdepends = xwayland-satellite: Xwayland support
	optdepends = xdg-desktop-portal-gtk: portal backend for everything but screencast
	optdepends = xdg-desktop-portal-wlr: ScreenCast and Screenshot portals, named by swayward-portals.conf
	optdepends = gnome-keyring: Secret portal
	optdepends = waybar: status bar, works unmodified against swayward IPC
	optdepends = fuzzel: application launcher bound in the default config
	optdepends = foot: terminal bound in the default config
	optdepends = swaylock: screen locker
	optdepends = swayidle: idle management
	optdepends = swaybg: wallpaper
	optdepends = mako: notifications
	optdepends = sway: provides swaymsg; swayward ships swaywardmsg, so this is optional
	options = !lto
	source = swayward-26.4.0.tar.gz::https://github.com/martintrojer/swayward/archive/refs/tags/v26.4.0.tar.gz
	sha256sums = SKIP

pkgname = swayward
