#!/usr/bin/env python3
"""Build and check the decoration matrix page and pixel measurements.

Each scene is one row with its square-corner and rounded-corner captures side
by side. A border-coloured pixel is stray when it has at most one
border-coloured 4-neighbour. Measurements are checked against the repository
baseline and also written to ``measurements.json``.
"""

from __future__ import annotations

import argparse
import html
import json
import re
import subprocess
from pathlib import Path

ACTIVE_BORDER = (255, 200, 127)
# The focused titlebar ring is the top of the window outline, so the shipped
# config gives it the active border colour and width. Read both from the
# config rather than hard-coding them, so the check follows the default.
DEFAULT_CONFIG = Path(__file__).resolve().parent.parent / "resources/default-config.kdl"


def shipped_titlebar_ring() -> tuple[tuple[int, int, int], int]:
    text = DEFAULT_CONFIG.read_text()
    block = text[text.index("    titlebar {") :]
    thickness = int(re.search(r"^\s*border-thickness (\d+)", block, re.M).group(1))
    focused = block[block.index("        focused {") :]
    color = re.search(r'border-color "#([0-9a-fA-F]{6})"', focused).group(1)
    return tuple(int(color[i : i + 2], 16) for i in (0, 2, 4)), thickness


TITLEBAR_BORDER, TITLEBAR_BORDER_THICKNESS = shipped_titlebar_ring()
BASELINE = Path(__file__).with_name("decoration-matrix-baseline.json")

# (id, title, what to look at). Order runs simple to compound so a defect is
# attributable to the smallest scene that shows it.
SCENES = [
