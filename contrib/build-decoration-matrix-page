    ("HB", "Horizontal split, stripped", "Two windows side by side, no compositor headers."),
    ("VA", "Vertical split, headers", "Stacked vertically. The lower window's top corners meet a titlebar."),
    ("VB", "Vertical split, stripped", "Stacked vertically, no headers."),
    ("TA", "Tabbed, one window, header", "A tab strip over one window."),
    ("TB", "Tabbed, one window, stripped", "A tab strip over one window, no client header."),
