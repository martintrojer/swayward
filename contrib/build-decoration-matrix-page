  zoomed = !zoomed;
  zoomBtn.setAttribute('aria-pressed', zoomed);
  zoomBtn.textContent = zoomed ? 'Showing corner crops' : 'Show corner crops';
  full.forEach(img => {
    img.src = zoomed ? img.dataset.crop : img.dataset.full;
    img.classList.toggle('zoom', zoomed);
  });
