def measure_image(path: Path) -> dict[str, int]:
    size = subprocess.run(
        ["magick", "identify", "-format", "%w %h", path],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    width, height = map(int, size.split())
    pixels = subprocess.run(
        ["magick", path, "-alpha", "off", "-depth", "8", "rgb:-"],
        check=True,
        capture_output=True,
    ).stdout
    expected = width * height * 3
    if len(pixels) != expected:
        raise SystemExit(f"{path.name}: expected {expected} RGB bytes, got {len(pixels)}")

    active = {
        index // 3
        for index in range(0, len(pixels), 3)
        if tuple(pixels[index : index + 3]) == ACTIVE_BORDER
    }
    if not active:
        raise SystemExit(f"{path.name}: no active-border pixels")

    top = bottom = 0
    for pixel in active:
        x, y = pixel % width, pixel // width
        neighbours = (
            (pixel - 1 if x else -1),
            (pixel + 1 if x + 1 < width else -1),
            (pixel - width if y else -1),
            (pixel + width if y + 1 < height else -1),
        )
        if sum(neighbour in active for neighbour in neighbours) <= 1:
            if y < height // 2:
                top += 1
            else:
                bottom += 1
    return {"top": top, "bottom": bottom, "total": top + bottom}


def assert_titlebar_ring(path: Path) -> None:
    size = subprocess.run(
        ["magick", "identify", "-format", "%w %h", path],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    width, height = map(int, size.split())
    pixels = subprocess.run(
        ["magick", path, "-alpha", "off", "-depth", "8", "rgb:-"],
        check=True,
        capture_output=True,
    ).stdout
    x = width // 2
    rows = [
        y
        for y in range(height)
        if tuple(pixels[(y * width + x) * 3 : (y * width + x + 1) * 3])
        == TITLEBAR_BORDER
    ]
    longest = current = 0
    previous = -2
    for y in rows:
        current = current + 1 if y == previous + 1 else 1
        longest = max(longest, current)
        previous = y
    if longest < TITLEBAR_BORDER_THICKNESS:
        raise SystemExit(
            f"{path.name}: expected a {TITLEBAR_BORDER_THICKNESS}px titlebar-border run, got {longest}px"
        )


def regressions(measurements: dict, baseline: dict, *, accept_new: bool = False) -> list[str]:
    """Scenes whose stray count rose, or that the baseline has never seen.

    A scene missing from the baseline fails a normal check, so a new scene
    cannot land unmeasured. When updating the baseline, a new scene is
    accepted only if it has no strays: adding coverage is fine, adding a
    scene that starts out broken is a regression dressed as a new row.
    """
    failures = []
    for scene, modes in measurements["scenes"].items():
        for mode, counts in modes.items():
            try:
                expected = baseline["scenes"][scene][mode]
            except KeyError:
                if not (accept_new and counts["total"] == 0):
                    failures.append(f"{scene}/{mode}: missing from baseline")
                continue
            for half in ("top", "bottom"):
                if counts[half] > expected[half]:
                    failures.append(
                        f"{scene}/{mode}/{half}: {counts[half]} > baseline {expected[half]}"
                    )
    return failures


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", default=".", type=Path)
    parser.add_argument("--baseline", default=BASELINE, type=Path)
    parser.add_argument(
        "--update-baseline",
        action="store_true",
        help="replace the baseline with measurements from this capture",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = args.root
    root.mkdir(parents=True, exist_ok=True)
    shots = root / "shots"
    rows = []
    missing = 0
    measurements = {
        "active_border": "#ffc87f",
        "stray_pixel": "at most one same-coloured 4-neighbour",
        "scenes": {},
    }
    for scene, title, look in SCENES:
        cells = []
        measurements["scenes"][scene] = {}
        for mode, _ in MODES:
            name = f"{mode}-{scene}.png"
            crop = f"{mode}-{scene}.crop.png"
            if (shots / name).exists():
                counts = measure_image(shots / name)
                measurements["scenes"][scene][mode] = counts
                cells.append(
                    f'<td><a href="shots/{name}"><img loading="lazy" '
                    f'data-full="shots/{name}" data-crop="shots/{crop}" '
                    f'src="shots/{name}" alt="{html.escape(title)}, {mode} corners"></a>'
                    f'<div class="measurement">strays: {counts["total"]} '
                    f'(top {counts["top"]}, bottom {counts["bottom"]})</div></td>'
                )
            else:
                missing += 1
                cells.append(f'<td><span class="missing">missing {html.escape(name)}</span></td>')
        rows.append(
            f'<tr><td class="name"><code>{html.escape(scene)}</code><br>'
            f"{html.escape(title)}<span class='look'>{html.escape(look)}</span></td>"
            + "".join(cells)
            + "</tr>"
        )

    headers = "".join(f"<th>{html.escape(label)}</th>" for _, label in MODES)
    page = f"""<!doctype html>
<meta charset="utf-8">
<title>swayward decoration matrix</title>
<style>{CSS}</style>
<h1>Decoration matrix</h1>
<p class="lede">Every scene captured with square and rounded window corners. The
two columns should differ only in corner radius. Anything else that changes, or
any square decoration sitting over a rounded frame, is a rendering defect.
Click an image for full size.</p>
<div class="controls">
  <button id="zoom" aria-pressed="false">Show corner crops</button>
  <span class="look">Crops magnify the top-left corner, where a square strip over a rounded frame shows.</span>
</div>
<table>
<thead><tr><th>Scene</th>{headers}</tr></thead>
<tbody>
{chr(10).join(rows)}
</tbody>
</table>
<script>{JS}</script>
"""
    output = root / "measurements.json"
    output.write_text(json.dumps(measurements, indent=2) + "\n")
    (root / "index.html").write_text(page)

    if not args.baseline.exists():
        raise SystemExit(f"baseline not found: {args.baseline}")
    assert_titlebar_ring(shots / "square-SA.png")
    failures = regressions(
        measurements,
        json.loads(args.baseline.read_text()),
        accept_new=args.update_baseline,
    )
    if failures:
        raise SystemExit("stray-pixel regressions:\n  " + "\n  ".join(failures))
    if args.update_baseline:
        args.baseline.write_text(json.dumps(measurements, indent=2) + "\n")
        print(f"updated {args.baseline}")

    print(
        f"wrote {root / 'index.html'} and {output} "
        f"({len(SCENES)} scenes, {missing} missing)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
