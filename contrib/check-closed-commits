#!/usr/bin/env python3
"""Fail when a CLOSED/done mu task names a commit whose change never reached main.

A task counts as shipped when every commit its CLOSE note names is on main:
    1. an ancestor of the target ref, or
    2. patch-id equal to a commit on the target ref (cherry-picked unchanged), or
    3. subject equal to a commit on the target ref (cherry-picked and amended).

Only the close note is read. Other notes cite base commits, mutation shas and
bisect endpoints, so grepping every note produces noise. Shas that no longer
exist as objects are reported separately: they were rebased away, so the close
note names something nobody can verify.

A deliberate outcome is recorded, not guessed. A task whose close note names a
dropped commit either closes as rejected/superseded, or carries a note
`SUPERSEDED-BY: <main sha>` or `NOT-SHIPPED: <reason>`, and this check accepts it.

This is an integrator tool, not a CI gate: it reads the mu task database on the
integrator's machine, which CI does not have. Run it after each push to main and
before closing a worker's task. contrib/check-task-drift covers the other
direction, worker commits that are not on main.

A pre-release history squash removed every commit made before it. Pass the
squash's sha map (`old new` per line) with --squash-map: a sha listed there
counts as shipped when its new sha is on the target ref.

Usage:
    contrib/check-closed-commits [--ref origin/main] [--since 2026-09-24] [-w swayward]
                                 [--squash-map FILE]
Exit 1 on any violation.
"""

import argparse
import json
import re
import subprocess
import sys

SHA = re.compile(r"\b[0-9a-f]{8,40}\b")
CLOSE = re.compile(r"^\s*CLOSE:", re.M)
ACCEPT = re.compile(r"^\s*(SUPERSEDED-BY|NOT-SHIPPED):", re.M)


def git(*args, check=True):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=check).stdout


def main_index(ref):
    ancestors = set(git("rev-list", ref).split())
    subjects = set(git("log", "--format=%s", ref).splitlines())
    patch = subprocess.run(
        ["git", "patch-id", "--stable"],
        input=git("log", "-p", "--format=commit %H", ref),
        capture_output=True, text=True, check=True,
    ).stdout
    patch_ids = {line.split()[0] for line in patch.splitlines()}
    return ancestors, subjects, patch_ids


def load_squash_map(path):
    if not path:
        return {}
    mapping = {}
    with open(path) as file:
        for line in file:
            if line.strip() and not line.startswith("#"):
                old, new = line.split()[:2]
                mapping[old] = new
    return mapping


def squashed(sha, mapping):
    """The new sha for an abbreviated pre-squash sha, if the map names one."""
    for old, new in mapping.items():
        if old.startswith(sha):
            return new
    return None


def status(sha, ancestors, subjects, patch_ids, mapping):
    new = squashed(sha, mapping)
    if new is not None:
        return "ok" if new in ancestors else "lost"
    full = git("rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}", check=False).strip()
    if not full:
        return "missing"
    if full in ancestors:
        return "ok"
    if git("show", "-s", "--format=%s", full).strip() in subjects:
        return "ok"
    pid = subprocess.run(["git", "patch-id", "--stable"], input=git("show", full),
                         capture_output=True, text=True).stdout.split()
    if pid and pid[0] in patch_ids:
        return "ok"
    return "lost"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ref", default="origin/main")
    ap.add_argument("--since", default="", help="ignore tasks closed before this date")
    ap.add_argument("-w", "--workstream", default="swayward")
    ap.add_argument("--squash-map", help="file of `old new` sha pairs from a history squash")
    args = ap.parse_args()

    workstream = args.workstream.replace("'", "''")
    rows = json.loads(subprocess.run(
        ["mu", "sql", "--json",
         "select t.local_id as task, t.substate, n.content, n.created_at from task_notes n "
         "join tasks t on t.id = n.task_id join workstreams w on w.id = t.workstream_id "
         f"where w.name = '{workstream}' and t.status = 'CLOSED' order by n.created_at"],
        capture_output=True, text=True, check=True).stdout)

    tasks = {}
    for row in rows:
        entry = tasks.setdefault(row["task"], {"substate": row["substate"], "close": None, "accepted": False})
        if CLOSE.search(row["content"]):
            entry["close"] = row
        if ACCEPT.search(row["content"]):
            entry["accepted"] = True

    ancestors, subjects, patch_ids = main_index(args.ref)
    mapping = load_squash_map(args.squash_map)
    lost, missing = [], []
    for task, entry in sorted(tasks.items()):
        close = entry["close"]
        if entry["substate"] != "done" or entry["accepted"] or close is None:
            continue
        if args.since and close["created_at"] < args.since:
            continue
        for sha in dict.fromkeys(SHA.findall(close["content"])):
            verdict = status(sha, ancestors, subjects, patch_ids, mapping)
            if verdict == "lost":
                lost.append((task, sha))
            elif verdict == "missing":
                missing.append((task, sha))

    for task, sha in lost:
        print(f"LOST     {task}: {sha} {git('show', '-s', '--format=%s', sha).strip()}")
    for task, sha in missing:
        print(f"MISSING  {task}: {sha} (no such object; rebased away?)")
    print(f"{len(lost)} lost, {len(missing)} missing")
    return 1 if lost or missing else 0


if __name__ == "__main__":
    sys.exit(main())
