#!/usr/bin/env python3
"""Check the inherited-file divergence ledger against the recorded niri base."""

import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# A moved file counts as inherited when git pairs it with a base file at this
# similarity or more. Below it, an unrelated added file can be paired with a
# deleted one. Each pairing is printed so a human can judge it.
RENAME_SIMILARITY = "50%"


def is_covered(path: str, covered: set[str]) -> bool:
    """An entry ending in "/" covers every path under that directory."""
    return path in covered or any(
        entry.endswith("/") and path.startswith(entry) for entry in covered
    )


def git(*args: str) -> str:
    return subprocess.check_output(
        # quotepath off: report non-ASCII paths verbatim so they match the ledger
        # whatever the caller's git config says (CI's default quotes them).
        ["git", "-c", "core.quotepath=false", "-C", ROOT, *args],
        text=True,
        stderr=subprocess.DEVNULL,
    )


def main(argv: list[str]) -> int:
    global ROOT
    if len(argv) > 1:
        ROOT = Path(argv[1]).resolve()
    base_doc = ROOT / "docs" / "FORK-BASE.md"
    ledger = ROOT / "docs" / "data" / "divergence.toml"
    base_match = re.search(r"commit ([0-9a-f]{40})", base_doc.read_text())
    if not base_match:
        print(f"check-divergence: no full base commit in {base_doc.relative_to(ROOT)}", file=sys.stderr)
        return 2
    base = base_match.group(1)

    try:
        git("cat-file", "-e", f"{base}^{{commit}}")
    except subprocess.CalledProcessError:
        print(f"check-divergence: niri base {base} is not available", file=sys.stderr)
        return 2

    with ledger.open("rb") as file:
        data = tomllib.load(file)
    edits = data.get("edit", [])
    migrated = sum(edit.get("migrated") is True for edit in edits)
    expected = data.get("migrated_entries")
    if expected != migrated:
        print(
            f"check-divergence: migrated_entries is {expected}, but found {migrated} migrated entries",
            file=sys.stderr,
        )
        return 1

    covered = {path for edit in edits for path in edit.get("paths", []) if path != "*"}
    base_files = set(git("ls-tree", "-r", "--name-only", base).splitlines())
    changed = set(
        git("diff", "--no-renames", "--diff-filter=M", "--name-only", base, "--").splitlines()
    )
    uncovered = sorted(path for path in changed & base_files if not is_covered(path, covered))

    # The pass above sees only files kept at their niri path. A moved file
    # (the niri-* to swayward-* crate renames, file splits) is a delete plus
    # an add there, so pair them by content and require an entry for any
    # moved file that was also edited. Either path may name it in the ledger.
    renamed = []
    for line in git(
        "-c", "diff.renameLimit=0", "diff", f"-M{RENAME_SIMILARITY}",
        "--diff-filter=R", "--name-status", base, "--",
    ).splitlines():
        status, old, new = line.split("\t")
        if status == "R100":
            continue
        renamed.append((status, old, new))
    uncovered_renames = [
        (status, old, new)
        for status, old, new in renamed
        if not is_covered(old, covered) and not is_covered(new, covered)
    ]

    if uncovered or uncovered_renames:
        print("check-divergence: inherited files missing from the ledger:", file=sys.stderr)
        for path in uncovered:
            print(f"  {path}", file=sys.stderr)
        for status, old, new in uncovered_renames:
            print(f"  {new} (moved from {old}, similarity {status[1:]}%)", file=sys.stderr)
        return 1

    print(
        f"check-divergence: {migrated} migrated and {len(edits) - migrated} added entries "
        f"cover {len(changed & base_files)} inherited files and {len(renamed)} edited moves"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
